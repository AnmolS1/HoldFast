# GitHub Actions secrets — NAMES ONLY. This file holds no value and must never hold one.
# The values live in the repository's Actions secrets (Settings → Secrets and variables → Actions)
# and are passed to exactly the steps listed here, through that step's `env:`.
# The deploy jobs name a GitHub environment (deploy-dev.yml: `dev`, deploy-prod.yml: `Production`).
# A secret set on the environment wins over a repository secret of the same name, so each value
# below can live on the one environment that uses it instead of on the repository.
#
# ci.yml reads NONE of them: it runs for pull requests (forks included) and needs no secret. Its
# e2e job writes its own .dev.vars from the published Turnstile test keys and fresh random values.

# Cloudflare API token for deploys. It cannot attach a custom domain: the first deploy of each
# environment is done by hand, CI only redeploys.
#   deploy-dev.yml    steps "The dev Worker exists and has its secrets", "Deploy"
#   deploy-prod.yml   steps "The production Worker exists and has its secrets", "Deploy"
#   scanner-image.yml steps "The Worker exists and has its secrets", "Deploy with a freshly built image"
CLOUDFLARE_API_TOKEN=
# The Cloudflare account the token acts on. Same steps as CLOUDFLARE_API_TOKEN.
CLOUDFLARE_ACCOUNT_ID=

# Neon DIRECT (non-pooled) connection strings, passed to drizzle-kit as DATABASE_URL_DIRECT.
#   deploy-dev.yml    step "Migrate the dev database"
NEON_DIRECT_URL_DEV=
#   deploy-prod.yml   step "Migrate the production database"
NEON_DIRECT_URL_PROD=

# Sentry auth token for releases.
#   deploy-prod.yml   job "sentry-release", step "Create and finalize the release"
SENTRY_AUTH_TOKEN=
