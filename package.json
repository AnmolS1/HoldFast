{
  "name": "holdfast",
  "version": "0.1.0",
  "description": "Holdfast — file storage on Cloudflare Workers, R2 and Postgres",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:dev": "vite build && wrangler deploy",
    "deploy": "CLOUDFLARE_ENV=production vite build && wrangler deploy --env production",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run -c vitest.config.ts && vitest run -c vitest.workers.config.ts",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config src/worker/auth/config.ts --output src/worker/db/auth-schema.ts -y",
    "invite": "tsx scripts/create-invite.ts",
    "cf-typegen": "wrangler types src/worker/env.d.ts --env-file .dev.vars.example --include-runtime=false --strict-vars=false && node --input-type=module -e \"import fs from 'node:fs'; const f = 'src/worker/env.d.ts'; fs.writeFileSync(f, fs.readFileSync(f, 'utf8').replace(/^(\\s*(?:PHOTODNA_SUBSCRIPTION_KEY|CF_ANALYTICS_TOKEN)): string;/gm, (_, k) => k + '?: string;'));\"",
    "test:c2": "node scripts/c2-abort-test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@cloudflare/containers": "0.3.7",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@mui/material": "9.4.0",
    "@mui/x-data-grid": "9.15.0",
    "@sentry/cloudflare": "11.5.0",
    "@sentry/react": "11.5.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "better-auth": "1.7.7",
    "client-zip": "2.5.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.3",
    "file-type": "22.1.1",
    "hash-wasm": "4.12.0",
    "hono": "4.13.13",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.53.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "resend": "6.32.1",
    "shiki": "4.5.0",
    "ua-parser-js": "2.0.10",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@sentry/vite-plugin": "5.4.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "4.1.11",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
